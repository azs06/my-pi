# ─── Channel type (pick one) ────────────────────────────────────────
# Only one channel is active at a time: "telegram", "slack", "discord", or "headless"
CHANNEL_TYPE=telegram

# ─── Telegram (when CHANNEL_TYPE=telegram) ──────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_ID=123456789

# ─── Discord (when CHANNEL_TYPE=discord) ───────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Channel ID for outbound-only messages (cron results, tool notifications)
DISCORD_DEFAULT_CHANNEL=1234567890123456789
# Comma-separated Discord user IDs that may interact with the bot (empty = open)
DISCORD_ALLOWED_USERS=1234567890123456789

# ─── Slack (when CHANNEL_TYPE=slack) ────────────────────────────────
# See docs/slack-setup.md for how to get these
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# Channel ID for outbound-only messages (cron results, tool notifications)
SLACK_DEFAULT_CHANNEL=C0123456789
# Comma-separated Slack user IDs that may interact with the bot (empty = open)
SLACK_ALLOWED_USERS=U0123456789,U9876543210

# ─── Optional ──────────────────────────────────────────────────────
# Anthropic API key (if not already in ~/.pi/agent/auth.json)
ANTHROPIC_API_KEY=sk-ant-...

# Default working directory for interactive sessions
DEFAULT_WORK_DIR=/Users/yourname/projects

# Base directory for all my-pi runtime data (default: ~/.my-pi)
MY_PI_HOME_DIR=/Users/yourname/.my-pi

# Dedicated Pi resource dir used only by my-pi for packages, skills, extensions,
# and settings (default: ~/.my-pi/agent). This keeps dashboard installs isolated
# from the main Pi harness config in ~/.pi/agent.
MY_PI_AGENT_DIR=/Users/yourname/.my-pi/agent

# Where to store cron job definitions (default: ~/.my-pi/cron-jobs.json)
CRON_JOBS_FILE=/Users/yourname/.my-pi/cron-jobs.json

# Optional web dashboard (token protected)
WEB_PORTAL_ENABLED=1
WEB_PORTAL_HOST=127.0.0.1
WEB_PORTAL_PORT=8787
WEB_PORTAL_TOKEN=replace_with_a_long_random_token
WEB_PORTAL_SESSION_TTL_MS=86400000

# ─── Memory / rate-limit tunables (important for Raspberry Pi) ─────
SESSION_IDLE_TIMEOUT_MS=900000
SESSION_MAX_MESSAGES=40
MAX_QUEUE_DEPTH=3
RATE_LIMIT_MS=2000

# ─── SQLite conversation persistence ──────────────────────────────
SQLITE_DB_PATH=/Users/yourname/.my-pi/messages.db
NOTES_DB_PATH=/Users/yourname/.my-pi/notes.db
RESTORE_RECENT_TURNS=5
