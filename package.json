{
  "name": "my-pi",
  "version": "1.0.0",
  "description": "Pi agent accessible via Telegram with cron job scheduling",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/my-pi",
    "build:debug": "bun build src/index.ts --compile --sourcemap=inline --outfile dist/my-pi-debug",
    "build:mac-arm": "bun build src/index.ts --compile --minify --target=bun-darwin-arm64  --outfile dist/my-pi-mac-arm64",
    "build:mac-x64": "bun build src/index.ts --compile --minify --target=bun-darwin-x64   --outfile dist/my-pi-mac-x64",
    "build:linux-arm": "bun build src/index.ts --compile --minify --target=bun-linux-arm64  --outfile dist/my-pi-linux-arm64",
    "build:linux-x64": "bun build src/index.ts --compile --minify --target=bun-linux-x64   --outfile dist/my-pi-linux-x64",
    "build:all": "npm run build:mac-arm && npm run build:mac-x64 && npm run build:linux-arm && npm run build:linux-x64"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.65.2",
    "@sinclair/typebox": "^0.34.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "uuid": "^11.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.8",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.4.5",
    "tsx": "^4.11.0"
  }
}
